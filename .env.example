# Clé API Resend pour l'envoi d'emails depuis app/api/contact/route.ts.
# Si absente, la route simule l'envoi (log console) au lieu d'échouer.
RESEND_API_KEY=

# Expéditeur des emails du formulaire de contact (doit être une adresse
# du domaine vérifié sur Resend — pas de noreply).
CONTACT_FROM_EMAIL=contact@studiovega.dev

# Délai de réponse annoncé dans l'email de confirmation envoyé au client.
CONTACT_RESPONSE_DELAY=48 h

# URL publique du site, utilisée par next-sitemap.config.js.
NEXT_PUBLIC_SITE_URL=https://studiovega.dev
